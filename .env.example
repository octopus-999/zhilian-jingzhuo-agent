# 智联净桌 AI 智能体演示系统 - 环境变量示例
# 复制为 .env 后填写真实值，留空则使用 Mock 演示模式

# 大模型 API（可选，接入后 AI 对话将调用真实模型）
VITE_LLM_API_KEY=
VITE_LLM_BASE_URL=

# YOLOv8n 视觉感知接口（可选，接入后使用真实目标检测）
VITE_YOLO_API_URL=

# 机器人控制接口（可选，接入后控制真实 STM32 硬件）
VITE_ROBOT_API_URL=

# RS485 通讯服务地址（可选）
VITE_RS485_API_URL=

# 演示模式：true=使用模拟数据，false=尝试调用真实接口
VITE_DEMO_MODE=true
